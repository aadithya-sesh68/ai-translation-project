# Copy to /home/adi/.config/oratranslate.env with mode 600.
# Values shown here are placeholders; never commit credential material.
OCI_CONFIG_FILE=/home/adi/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_REGION=us-phoenix-1
OCI_COMPARTMENT_ID=replace-with-authorized-compartment-ocid
TRANSLATION_BUFFER_SECONDS=1.5
TRANSLATION_QUEUE_MAX_ITEMS=120
AUDIO_QUEUE_MAX_CHUNKS=64
CLIENT_EVENT_QUEUE_MAX_ITEMS=128
HOST_RECONNECT_GRACE_SECONDS=60
PREPARED_SESSION_TIMEOUT_SECONDS=1800
ORATRANSLATE_LOG_LEVEL=INFO
SPEECH_WEB_ALLOWED_ORIGINS=https://venus.aisandbox.ugbu.oraclepdemos.com
SESSION_STORAGE_DIR=/home/adi/oratranslate-data/recorded_sessions
